# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/instant_mechanic?retryWrites=true&w=majority

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Set to "true" to auto-run a background job that randomly progresses a few
# bookings through their status lifecycle, emitting Socket.IO events.
# Great for demoing the "live" dashboard without manual clicks.
ENABLE_LIVE_SIMULATION=true
SIMULATION_INTERVAL_MS=8000
